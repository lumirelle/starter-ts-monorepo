{
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "nub@0.5.0",
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.5.0",
      "onFail": "warn"
    }
  },
  "workspaces": {
    "packages": [
      "docs",
      "playground",
      "packages/*"
    ],
    "catalogs": {
      "dev": {
        "taze": "^19.16.0"
      },
      "types": {
        "@lumirelle/tsconfig": "^0.1.6",
        "@types/node": "^26.1.1",
        "typescript": "npm:typescript-native-bridge@^6.0.3-bridge.6.tsgo.7.0.2"
      },
      "build": {
        "tsdown": "^0.22.14"
      },
      "docs": {
        "@iconify-json/svg-spinners": "^1.2.4",
        "@shikijs/vitepress-twoslash": "^4.3.1",
        "@unocss/reset": "^66.7.5",
        "@vueuse/core": "^14.3.0",
        "floating-vue": "^5.2.2",
        "oxc-minify": "^0.141.0",
        "pinia": "^4.0.2",
        "unocss": "^66.7.5",
        "unplugin-vue-components": "^32.1.0",
        "vite": "^8.1.5",
        "vitepress": "^2.0.0-alpha.18",
        "vitepress-plugin-group-icons": "^1.7.5",
        "vue": "^3.5.40"
      },
      "check": {
        "@antfu/eslint-config": "^9.2.0",
        "@arethetypeswrong/cli": "^0.18.5",
        "@lumirelle/oxlint-config": "^0.13.0",
        "eslint": "^10.8.0",
        "eslint-plugin-oxlint": "^1.75.0",
        "knip": "^6.29.0",
        "oxlint": "^1.75.0",
        "oxlint-tsgolint": "^7.0.2001",
        "publint": "^0.3.22"
      },
      "test": {
        "@vitest/coverage-v8": "^4.1.10",
        "tsnapi": "^1.2.0",
        "vitest": "^4.1.10"
      },
      "release": {
        "bumpp": "^12.0.0",
        "changelogithub": "^14.0.0",
        "pkg-pr-new": "^0.0.80"
      }
    }
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:check",
    "@arethetypeswrong/cli": "catalog:check",
    "@lumirelle/oxlint-config": "catalog:check",
    "@lumirelle/tsconfig": "catalog:types",
    "@types/node": "catalog:types",
    "@vitest/coverage-v8": "catalog:test",
    "bumpp": "catalog:release",
    "changelogithub": "catalog:release",
    "eslint": "catalog:check",
    "eslint-plugin-oxlint": "catalog:check",
    "knip": "catalog:check",
    "oxlint": "catalog:check",
    "oxlint-tsgolint": "catalog:check",
    "pkg-pr-new": "catalog:release",
    "publint": "catalog:check",
    "taze": "catalog:dev",
    "tsnapi": "catalog:test",
    "typescript": "catalog:types",
    "vitest": "catalog:test"
  },
  "overrides": {
    "typescript": "catalog:types",
    "vite": "catalog:docs",
    "vue": "catalog:docs"
  }
}

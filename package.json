        "eslint": "^10.8.1",
        "eslint-plugin-oxlint": "^1.78.0",
        "knip": "^6.32.2",
        "oxlint": "^1.78.0",
        "oxlint-tsgolint": "^7.0.2001",
        "publint": "^0.3.23"
      },
